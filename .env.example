# Copy to .env (gitignored). npm start loads it locally; inherited environment
# variables take precedence. Do not put this file in a project workspace.
OPENROUTER_API_KEY=
FIGMA_ACCESS_TOKEN=

# Explicit local development mode: normal permissions, quick local identities,
# and sign-in emails written privately to .dialogue-data/mail (never sent).
DIALOGUE_MODE=development
DIALOGUE_ORIGIN=http://localhost:4173
DIALOGUE_OWNER_EMAIL=owner@example.test
DIALOGUE_OWNER_NAME=Owner
DIALOGUE_INITIAL_MEMBERS=editor@example.test
DIALOGUE_WORKSPACE_NAME=Idealogue

# Workers default to direct in local development and isolated in production.
# Production requires the Linux host contract in docs/WORKERS.md; direct mode
# is rejected even when requested explicitly. Keep the default pilot limits.
# DIALOGUE_WORKER_BUDGET_MB=2048
# DIALOGUE_WORKER_QUEUE=8
# DIALOGUE_WORKER_WAIT_MS=60000
# DIALOGUE_WORKER_DISK_FLOOR_MB=1024

# Production: DIALOGUE_MODE=production, NODE_ENV=production and your exact
# HTTPS DIALOGUE_ORIGIN. Set real owner/member addresses above; use an SMTP
# credential stored only in the deployment's secret environment file.
# DIALOGUE_SMTP_URL=smtps://user:password@mail.example.com:465
# DIALOGUE_MAIL_FROM=Dialogue <dialogue@example.com>
